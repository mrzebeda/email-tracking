# ===========================================
# AI Sales Email Tracker - Configuratie
# ===========================================

# --- OpenAI (voor AI-gegenereerde emails) ---
OPENAI_API_KEY=sk-...

# --- SMTP Email Configuratie ---
# Voor Outlook / Office 365:
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=jouw-email@bedrijf.com
SMTP_PASS=jouw-wachtwoord
EMAIL_FROM_NAME=Jouw Naam
EMAIL_FROM_ADDRESS=jouw-email@bedrijf.com

# Voor Gmail (alternatief):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=jouw-email@gmail.com
# SMTP_PASS=jouw-app-wachtwoord

# --- Tracking Server ---
# URL waar de tracking pixel gehost wordt (Netlify of eigen server)
TRACKING_URL=https://jouw-site.netlify.app/.netlify/functions/track
# Of lokaal: http://localhost:3001/track

# --- Microsoft Azure (optioneel - voor Excel via Graph API) ---
TENANT_ID=jouw-tenant-id
CLIENT_ID=jouw-client-id
CLIENT_SECRET=jouw-client-secret

# --- Bedrijfsinformatie (voor AI email generatie) ---
COMPANY_NAME=Richfield Distribution
COMPANY_DESCRIPTION=Global polyethylene resin distribution - LLDPE, LDPE, HDPE
SALES_PERSON_NAME=Jouw Naam
SALES_PERSON_TITLE=Sales Manager

# --- IMAP Inbox Monitoring (voor reply detectie) ---
# Voor Outlook / Office 365:
IMAP_HOST=outlook.office365.com
IMAP_PORT=993
IMAP_USER=jouw-email@bedrijf.com
IMAP_PASS=jouw-wachtwoord

# Voor Gmail (alternatief):
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=jouw-email@gmail.com
# IMAP_PASS=jouw-app-wachtwoord

# --- Reminder Instellingen ---
# Reminder als email NIET geopend is (in uren):
REMINDER_UNOPENED_AFTER_HOURS=48
# Reminder als email WEL geopend maar NIET beantwoord (in uren):
REMINDER_OPENED_NO_REPLY_AFTER_HOURS=72
# Max aantal reminders per contact:
MAX_REMINDERS=2

# --- Auto-Reply Instellingen ---
# Automatisch reageren als een klant antwoordt? (true/false)
AUTO_REPLY_ENABLED=false
