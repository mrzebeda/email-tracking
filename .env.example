# ===========================================
# AI Sales Email Tracker - Configuratie
# ===========================================

# --- OpenAI (voor AI-gegenereerde emails) ---
OPENAI_API_KEY=sk-...

# --- SMTP Email Configuratie ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=jouw-email@gmail.com
SMTP_PASS=jouw-app-wachtwoord
EMAIL_FROM_NAME=Jouw Bedrijf
EMAIL_FROM_ADDRESS=sales@jouwbedrijf.nl

# --- Tracking Server ---
# URL waar de tracking pixel gehost wordt (Netlify of eigen server)
TRACKING_URL=https://jouw-site.netlify.app/.netlify/functions/track
# Of lokaal: http://localhost:3001/track

# --- Microsoft Azure (optioneel - voor Excel via Graph API) ---
TENANT_ID=jouw-tenant-id
CLIENT_ID=jouw-client-id
CLIENT_SECRET=jouw-client-secret

# --- Bedrijfsinformatie (voor AI email generatie) ---
COMPANY_NAME=Jouw Bedrijf BV
COMPANY_DESCRIPTION=Wij leveren hoogwaardige producten en diensten
SALES_PERSON_NAME=Jan de Verkoper
SALES_PERSON_TITLE=Sales Manager

# --- Reminder Instellingen ---
REMINDER_AFTER_HOURS=48
MAX_REMINDERS=2
